# OpenAI-compatible LLM (interest parsing + event ranking).
# Can point at a proxy/aggregator via OPENAI_BASE_URL instead of the real
# OpenAI API.
OPENAI_API_KEY=
# Optional second key, tried automatically once OPENAI_API_KEY's daily quota
# is exhausted (see app/llm_client.py). Leave blank to disable rotation.
OPENAI_API_KEY_FALLBACK=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Purely for the "X / cap" display in Insights — not enforced, just visibility.
LLM_DAILY_CAP=

# Optional — logs usage to a Supabase `llm_calls` table if you want
# cost/latency tracking across multiple projects sharing one key. Leave
# blank to only track usage locally for this project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Event data sources — leave blank to skip that connector.
# The mock connector always runs so the app works with zero keys.
TICKETMASTER_API_KEY=
PREDICTHQ_API_KEY=
EVENTBRITE_TOKEN=

# Automatic background ingest interval, in hours. 0 disables it (manual
# "Refresh" only).
INGEST_INTERVAL_HOURS=12

# Restricts data sources to urbtix (data.gov.hk's open data feed) only --
# see app/config.py and ingest_job.py for what this actually gates.
DEMO_MODE=

# Storage
DATABASE_URL=sqlite:///./event_radar.db
